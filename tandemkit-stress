#!/bin/bash
# The stress lane's commands (`./tandemkit-stress --help`); docs/lane.md.
d=${BASH_SOURCE[0]}; if [[ $d == */* ]]; then d=${d%/*}; else d=.; fi
cd "$d" || exit 1
[ -x .venv/bin/python ] || { echo "tandemkit-stress: virtualenv missing; run $PWD/setup.sh" >&2; exit 1; }
export PATH="$PWD/.venv/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"
exec "$PWD/.venv/bin/python" -m tkstress "$@"
